{
  "name": "@studying-skills/spellengine",
  "version": "0.1.0",
  "description": "StudyFlow speller (Rust compiled to WebAssembly): words of a paragraph against Hunspell dictionaries",
  "license": "MIT",
  "type": "module",
  "main": "sfdoc_spell_wasm.js",
